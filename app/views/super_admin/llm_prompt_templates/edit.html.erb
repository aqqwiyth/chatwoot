<% content_for(:title) { "Edit #{@template.key}" } %>
<header class="main-content__header"><h1 class="main-content__page-title">Edit <%= @template.key %></h1></header>
<section class="main-content__body"><%= form_with model: @template, url: super_admin_llm_prompt_template_path(@template), method: :patch, class: 'grid gap-4' do |form| %><%= form.text_area :content, rows: 30, class: 'border rounded p-3 font-mono text-sm w-full' %><p class="text-xs text-slate-500">Liquid syntax is validated on save. Required variables and output schemas remain enforced by the calling service.</p><%= form.submit 'Save template', class: 'button button--primary w-fit' %><% end %></section>
